+
+            // 非空转：显式不铺细带时，同一窗口里有远场粗格
+            var (_, touchOld, noteOld) = Window(BuildRing(g, lc));
+            _out.WriteLine($"{name}：不铺细带时窗口里最大格 {touchOld:0.###} mm　记录：{noteOld}");
