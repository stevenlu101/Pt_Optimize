+        int mid = r.TMetal.Length / 2;
+        Assert.InRange(r.TMetal[mid], p.TSetC - 0.5, p.TSetC + 0.5);   // 与 VerificationTests.Segment_CurrentSatisfiesSetpointAndJConstraint 同一容差
