+         : r.AllOk ? "全判据通过"
+         : $"有判据不过或判不了：{string.Join("；", r.Failed)}";
+
+    private static string Short(LineResult? r)
+        => r is null ? "没跑" : !r.Ok ? "判不了" : !r.Converged ? "未收敛" : r.AllOk ? "过" : "不过／判不了";
