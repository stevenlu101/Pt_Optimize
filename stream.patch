+    /// <summary>门 d 第 ② 步的表差：工作区间、新旧表最大相对差 δq 与最坏处，以及某温度上三张新表 q/(dq/dT) 的最大值。2026-09-15 Opus 5。</summary>
+    private sealed record TableDiff(double LoC, double HiC, double DeltaQ, double WorstAtC, Func<double, double> QOverSlopeAt);
+
+    /// <summary>
+    /// 新旧两套表（调生产的 ShellThermal.SurfaceLossTablesFor，只换上限与节点数，不手抄热流配方）在工作温度区间上逐 1 K 比（区间右端点也比）。
+    /// 工作区间 = 新旧两次解的场温度范围取并 —— 用的是**温度范围**，不是结果之差。2026-09-15 Opus 5。
+    /// </summary>
+    private static TableDiff TableBound(DesignInputs p2, double tabInsulMm, double oldHiC, int oldNodes, ShellThermalResult thOld, ShellThermalResult thNew)
+    {
+        var tOld = ShellThermal.SurfaceLossTablesFor(p2, tabInsulMm, oldHiC, oldNodes);
+        var tNew = ShellThermal.SurfaceLossTablesFor(p2, tabInsulMm);
+        double lo = Math.Min(thOld.TMinC, thNew.TMinC), hi = Math.Max(thOld.TMaxC, thNew.TMaxC);
+        double worst = 0, at = lo;
+        var pairs = new[] { (Old: tOld.Bare, New: tNew.Bare), (Old: tOld.Disc, New: tNew.Disc), (Old: tOld.Tab, New: tNew.Tab) };
+        var ts = Enumerable.Range(0, (int)Math.Floor(hi - lo) + 1).Select(k => lo + k).Append(hi);
+        foreach (double t in ts)
+            foreach (var pr in pairs)
+            {
+                double qo = pr.Old.Eval(t), qn = pr.New.Eval(t);
+                double rel = Math.Abs(qn - qo) / Math.Abs(qo);
+                if (rel > worst) { worst = rel; at = t; }
+            }
+        double QOverSlope(double t) => pairs.Max(pr => Math.Abs(pr.New.Eval(t) / pr.New.Slope(t)));
+        return new TableDiff(lo, hi, worst, at, QOverSlope);
+    }
