+    private static DesignSpec Clone(DesignSpec d0, double discMm)
+    {
+        var d = d0.Clone();
+        d.FlangeInsulated = true;
+        d.FlangeInsulMm = discMm;
+        d.DiscInsulMm = Array.Empty<double>();
