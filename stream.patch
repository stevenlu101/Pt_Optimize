+            Array.Empty<(double, double, ResistivitySuspectKind, string)>()),
+        new ResistivityTestRow("Cu", "E44", 44, -1, -1,   // 没有計算值／SSE 行；X44、Y44 字面 0 = 缺测
+            new[] { N, 1.7, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N },
