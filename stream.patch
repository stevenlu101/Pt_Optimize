+    private static LayerResult RunLayer(DesignSpec d0, DesignInputs p, Options o, int T, int lowerBound, double radiusMm, Action<string> log)
+    {
+        var sw = Stopwatch.StartNew();
+        var lr = new LayerResult { TubeLayer = T };
