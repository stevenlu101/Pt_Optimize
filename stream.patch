+                    RootsAt(its[km].Last!, wp.Ends, out t.RootMinusC);
+                    t.SlopeKPerW = Enumerable.Range(0, wp.Ends.Length).Select(e => TubeSlopeKPerW(t.RootPlusC[e], t.RootMinusC[e], o.GammaProbeW)).ToArray();
