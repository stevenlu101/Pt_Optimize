+    act = PROBE[L]['cold'] if L in PROBE else float('nan')
+    print(f"    L{L}: 模型 ΔQ_hot {dQ:+7.1f} W ⇒ 外推管根低于热偶读数 ≈ {est:7.1f} K　"
+          + (f"（实测 {act:.1f} K）" if act == act else "（没有实测）"))
