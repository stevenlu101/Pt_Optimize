+        // 评估函数写漏工况位 ⇒ EvaluateView 按 v 盖上
+        var forgetful = new Options { Criteria = (v, o) => new List<Criterion> { new() { Name = HotName, LineKey = LineResult.Key.HotOverTc, NormMargin = -1 } } };
