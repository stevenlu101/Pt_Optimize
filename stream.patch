+            var x = Grid(L, n); int m = n / 2;
+            Assert.Equal(L / 2, x[m], 9);                       // 节点数为奇数 ⇒ 控温点落在中点
+            var g = x.Select(v => a + b * v).ToArray();
+            var (dA, dB) = RampElongation.Halves(x, g, m);
