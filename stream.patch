+        int n = m.CellCount;
+        var rects = new List<(double x0, double x1, double z0, double z1)>[n];
+        for (int c = 0; c < n; c++) rects[c] = new List<(double, double, double, double)> { CellRect(m, c) };
+        if (!(holeRadiusMm > 0) || n == 0) return rects;
+        double rh = holeRadiusMm;
+        var cellAt = new Dictionary<(int, int), int>(n);
+        for (int c = 0; c < n; c++) cellAt[cellIJ[c]] = c;
+        var removed = new bool[n]; var target = new int[n];
+        for (int c = 0; c < n; c++) target[c] = -1;
+        int merged = 0;
+        for (int c = 0; c < n; c++)
+        {
+            var (x0, x1, z0, z1) = rects[c][0];
+            double nx = Math.Clamp(0, x0, x1), nz = Math.Clamp(0, z0, z1);
+            double fx = Math.Max(Math.Abs(x0), Math.Abs(x1)), fz = Math.Max(Math.Abs(z0), Math.Abs(z1));
+            if (nx * nx + nz * nz >= rh * rh || fx * fx + fz * fz <= rh * rh) continue;   // 孔圆不穿过这一格
+            var (ci, cj) = cellIJ[c];
+            // 四条边：有料长度、是否被孔圆穿过（边上最近点 < rh < 最远点）、对面的邻格
+            var edges = new List<(double len, bool crossed, int nb)>();
+            void Edge(bool vertical, double line, double a, double b, int ni, int nj)
+            {
+                var (len, _) = f.SegmentMaterial(vertical, line, a, b);
+                double near = vertical ? Math.Sqrt(line * line + Math.Clamp(0, a, b) * Math.Clamp(0, a, b)) : Math.Sqrt(Math.Clamp(0, a, b) * Math.Clamp(0, a, b) + line * line);
+                double far = vertical ? Math.Sqrt(line * line + Math.Max(a * a, b * b)) : Math.Sqrt(Math.Max(a * a, b * b) + line * line);
+                bool crossed = near < rh - 1e-12 && far > rh + 1e-12;
+                int nb = cellAt.TryGetValue((ni, nj), out int v) ? v : -1;
+                edges.Add((len, crossed, nb));
+            }
+            Edge(true, x0, z0, z1, ci - 1, cj); Edge(true, x1, z0, z1, ci + 1, cj);
+            Edge(false, z0, x0, x1, ci, cj - 1); Edge(false, z1, x0, x1, ci, cj + 1);
+            var mat = edges.Where(e => e.len > 1e-9).ToList();
+            if (mat.Count == 0 || mat.Any(e => !e.crossed)) continue;             // 有一条通向未被孔圆穿过的邻格 ⇒ 不是外角薄片
+            var best = mat.Where(e => e.nb >= 0).OrderByDescending(e => e.len).FirstOrDefault();
+            if (best.nb < 0) continue;
+            int t = best.nb;
+            while (removed[t]) t = target[t];
+            if (t == c) continue;
+            // 并：面积、体积、一次矩相加
+            double aC = m.Area[c], aT = m.Area[t];
+            double vol = aC * m.Thickness[c] + aT * m.Thickness[t];
+            double mx = aC * m.Centroid[c].X + aT * m.Centroid[t].X, mz = aC * m.Centroid[c].Z + aT * m.Centroid[t].Z;
+            m.Area[t] = aC + aT;
+            m.Thickness[t] = vol / m.Area[t];
+            m.Centroid[t] = new Vec3(mx / m.Area[t], m.Centroid[t].Y, mz / m.Area[t]);
+            var (tx0, tx1, tz0, tz1) = rects[t][0];
+            m.Frac[t] = m.Area[t] / ((tx1 - tx0) * (tz1 - tz0));
+            rects[t].AddRange(rects[c]);
+            removed[c] = true; target[c] = t; merged++;
+        }
+        if (merged == 0) return rects;
+        // 压实
+        var keep = Enumerable.Range(0, n).Where(c => !removed[c]).ToArray();
+        var newIndex = new int[n]; for (int k = 0; k < keep.Length; k++) newIndex[keep[k]] = k;
+        if (slivers != null)
+            for (int c = 0; c < n; c++)
+                if (removed[c]) { int t = target[c]; while (removed[t]) t = target[t]; var r0 = rects[c][0]; slivers.Add((r0.x0, r0.x1, r0.z0, r0.z1, newIndex[t])); }
+        var cells = keep.Select(c => m.Cells[c]).ToList();
+        var area = keep.Select(c => m.Area[c]).ToList();
+        var cen = keep.Select(c => m.Centroid[c]).ToList();
+        var th = keep.Select(c => m.Thickness[c]).ToList();
+        var part = keep.Select(c => m.Part[c]).ToList();
+        var frac = keep.Select(c => m.Frac[c]).ToList();
+        var rr = keep.Select(c => rects[c]).ToArray();
+        m.Cells.Clear(); m.Cells.AddRange(cells);
+        m.Area.Clear(); m.Area.AddRange(area);
+        m.Centroid.Clear(); m.Centroid.AddRange(cen);
+        m.Thickness.Clear(); m.Thickness.AddRange(th);
+        m.Part.Clear(); m.Part.AddRange(part);
+        m.Frac.Clear(); m.Frac.AddRange(frac);
+        m.HoleSliversMerged = merged;
+        return rr;
+    }
+
+    /// <summary>
+    /// ★ 2026-09-18，Fable 5.1：单元有料面积里落在 r ≤ <paramref name="radiusMm"/> 的份额 —— 保温分界圆穿过的格子怎么混（ShellThermal 调这一处）。
+    /// 解析板按精确积分（<see cref="AnalyticMaterial.FractionInsideCircle"/>），栅格场按方格中心（与 R48 的 <see cref="MaterialFraction"/> 逐位相同）。
+    /// 没有材料来源或格里没有料 ⇒ NaN（调用方退回形心）。
+    /// </summary>
+    public static double MaterialFractionInCircle(ShellMesh m, int cell, double radiusMm)
+    {
+        if (m.Material is null || cell < 0 || cell >= m.CellCount) return double.NaN;
+        var nd = m.Cells[cell];
+        double x0 = double.PositiveInfinity, x1 = double.NegativeInfinity, z0 = double.PositiveInfinity, z1 = double.NegativeInfinity;
+        foreach (int n in nd)
+        {
+            var v = m.Nodes[n];
+            x0 = Math.Min(x0, v.X); x1 = Math.Max(x1, v.X); z0 = Math.Min(z0, v.Z); z1 = Math.Max(z1, v.Z);
+        }
+        return m.Material.FractionInsideCircle(x0, x1, z0, z1, radiusMm);
+    }
