+                  : $"★ **求解器抛异常或没返回** ⇒ {tag} 没有解出来的设计 ⇒ 这一档的三关不跑。");
+            W("");
+            return;
+        }
+        W($"结论：{(sr.Feasible ? "**全判据通过**（可行）" : "**不可行**（求解器没把全部判据补上）")}　停因：{sr.StopWhy}");
+        if (sr.HitBound) W("　⚠ 结构性停机（旋钮顶到上界／分派前提不成立／交棒）：再算一次会得到同一句话，不是「没搜到」。");
+        if (sr.NullWhy.Length > 0) W($"　⚠ 最近一次场解没解出来的原因：{sr.NullWhy}");
