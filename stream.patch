diff --git a/Pt_Optimize.Tests/R48DesignCurrentVsSegmentCurrentTests.cs b/Pt_Optimize.Tests/R48DesignCurrentVsSegmentCurrentTests.cs
new file mode 100644
index 0000000..6b547be
--- /dev/null
