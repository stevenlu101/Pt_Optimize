+    private static double Bisect(Func<double, double> f, double a, double b)
+    {
+        bool fa = f(a) < 0;
+        for (int i = 0; i < 40; i++)
+        {
+            double m = 0.5 * (a + b);
+            if ((f(m) < 0) == fa) a = m; else b = m;
+        }
+        return 0.5 * (a + b);
+    }
