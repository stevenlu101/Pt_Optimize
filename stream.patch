+                  + (cov.Count == 0 ? "区间内" : string.Join("；", cov)));
+            }
+            W();
+        }
+
+        W("═══════ 每个牌号每个量的最大相对差（绝对值）═══════");
+        W("牌号／量\t最大相对差 %");
+        foreach (var kv in maxAbs.OrderByDescending(kv => double.IsNaN(kv.Value) ? -1 : Math.Abs(kv.Value)))
