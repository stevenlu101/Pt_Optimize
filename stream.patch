+        }
+        bool rFJudgeable = why.Count == 0;
+        bool byRatio = rFJudgeable && rF <= rC - 0.10, byStep = stepF <= 0.5 * stepC;
+        bool literal = !double.IsNaN(rF) && rF <= rC - 0.10;
