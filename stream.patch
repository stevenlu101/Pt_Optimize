+        Assert.Contains("外层耦合没收敛", ncv.Why);
+        // 缺一态 ⇒ 不可行
+        Assert.False(FinalLineVerdict(new LineSolve { ByState = new LineResult?[] { Mk(false), null } }).Ok);
