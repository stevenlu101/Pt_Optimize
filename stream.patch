+        d.TubeInsulMm = 2.0;
+        Assert.Equal(2.0, InsulationPlan.Build(r, d, p).Single(w => w.Zone == "管身 内层（贴铂）").ThickMm, 9);
+    }
+
+    /// <summary>片名取自 <c>LineResult.Flanges</c>（这一次真的解了哪几片），不在表里另起一套片名。</summary>
+    [Fact]
