+                    + "三处差的值 = R48LThreeMeshTests 那一跑的反射逐字段比（R 格式往返，逐位）。");
+        sb.AppendLine("六次来自同一次运行、同一个进程，不拼两份输出。");
+        File.WriteAllText(file, sb.ToString(), new UTF8Encoding(true));
+        _o.WriteLine(sb.ToString());
+        Console.WriteLine(sb.ToString());
+    }
+}
