+        const double L = 300.0, tSet = 900.0, dT = 50.0;
+        (double A, double B) Run(int n)
+        {
+            var x = Grid(L, n);
+            var t = x.Select(v => tSet + dT * Math.Cos(Math.PI * v / L)).ToArray();
+            var g = RampElongation.StrainDiff(t, tSet, "Pt", out var cov, out _);
