+            throw new InvalidOperationException($"片{j}：热偶读数的管根较热端／较冷端 {tc.RootHotC:R}／{tc.RootColdC:R} °C 与按端号数出的不是同一个值 —— 两份「各端取较热／较冷」漂开了");
