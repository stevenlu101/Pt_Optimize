+                double x = x0 + (i + 0.5) * (x1 - x0) / n, z = z0 + (j + 0.5) * (z1 - z0) / n;
+                if (!g.Inside(x, z)) continue;
+                a += da; v += da * g.ThicknessAt(x, z);
+            }
+        return (a, v);
