+            Assert.Equal(xT, g.Tangent().X);
+            _out.WriteLine($"板：舌尖 {g.TabTipXMm:0.###}　舌盘分界 {xT:0.###}　压接段内边 {g.TabTipXMm + clamp:0.###}　管孔半径 {holeR}");
