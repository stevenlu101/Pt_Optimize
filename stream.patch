+        if (i < 0) return note.Length > 0 ? note : "（判据没给逐片的数）";
+        int j = note.IndexOf('。', i);
+        return j > i ? note.Substring(i, j - i) : note.Substring(i);
+    }
+
+    private static string Fmt(double v) => double.IsNaN(v) ? "—" : v.ToString("0.###");
