+
+        Assert.True(rows.Count == ScanCount, "扫描档数对不上");
+        Assert.True(rows.Any(r => r.Ok), $"舌长 {tabLenMm:0}：51 档一次整线解都没解出来 —— 这不是「不可行」，是算不出来");
