+/// <summary>APP 牌号 → 膨胀曲线的显式映射（每个 MaterialDb 牌号都必须有一条，不许默认）。2026-09-15，Opus 5。</summary>
+public sealed record GradeExpansionMap(string Grade, string? CurveId, ExpansionLink Link, string Why);
