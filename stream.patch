+    /// <summary>
+    /// 工作簿 Y 列公式 =V*(1+X*0.000001*U) 的原样实现（门拿 Y14:Y16 缓存逐位核）。
+    /// ⚠ L0 是 **0 °C 长度**；图纸长度若是 20 °C 的，伸长偏大约 175 µε（950 °C 时约 2 %）。
+    /// </summary>
+    public static double HotLengthFromAlpha(double l0, double alphaE6, double tC) => l0 * (1 + alphaE6 * 0.000001 * tC);
