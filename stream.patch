+                var fp = SegmentSolver.EndTempFixedPointAt(p, wall, tEnd);
+                _o.WriteLine($"节点 {n}　T端 {tEnd:0.00} °C　β′ {beta:0.0000} W/(m·K)　ℓt {lt * 1000:0.000} mm　"
