+                    sb.AppendLine($"          ② 第一版参考行算法（控温点取值）β {s0.BetaWPerMK:0.0000} W/(m·K)　ℓt {s0.DecayLengthMm:0.0} mm　Δx {dxMm:0.####} mm　"
