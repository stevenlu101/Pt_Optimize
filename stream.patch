+            Say("");
+            Say($"══ {state}：Ok {r.Ok}　收敛 {r.Converged}　{sw.Elapsed.TotalSeconds:0} s　控温点 {string.Join("/", lc.SetpointC.Select(v => v.ToString("0", Inv)))} °C　升温 {lc.RampFromC:0}→{lc.RampTargetC:0} °C、{lc.RampRateKPerH:0} K/h");
