+        W("　管孔净流入 = FlangeOut.QFromTubeW（>0 = 从管子抽热）。");
+        W("舌保温 mm\t舌板焦耳热 W\t舌板表面散热 W\t进铜排夹 W\t管孔净流入 W\t（焦耳热 − 进夹）W");
+        foreach (var r in rows.Where(r => (int)Math.Round(r.InsulMm * 10) % 5 == 0))
