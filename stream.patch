+        var sw = Stopwatch.StartNew();
+        probe.Report($"── 开始 ②（{tag}）");
+        LineResult r;
+        try { r = LineRunner.Run(d.Clone().BuildCase(p), probe); }
+        catch (Exception ex) { r = new LineResult { Ok = false, Message = $"{ex.GetType().Name}：{ex.Message}" }; }
+        sw.Stop();
