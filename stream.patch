+                   + $"　旧 {Old(0):0.0}/{Old(300):0.0}/{Old(500):0.0}/{Old(1150):0.0}/{Old(1300):0.0}"
+                   + $"　1150 °C 处 +{(r1150 - 1) * 100:0.0} %");
+    }
