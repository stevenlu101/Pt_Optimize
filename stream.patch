+        Assert.Equal(expectThick, m.Groups[4].Value);
+        Assert.Equal(expectTongue, m.Groups[1].Value);
+        Assert.NotEqual(m.Groups[2].Value, m.Groups[4].Value);   // 板厚不是传入值（旧写法会在这里红）
+    }
+}
