+        Assert.True(new LayerResult { Starts = so, FinalLineAllOk = true }.Feasible);
+        Assert.False(new LayerResult { Starts = so, FinalLineAllOk = false }.Feasible);
+        Assert.False(new LayerResult { Starts = so }.Feasible);
+    }
