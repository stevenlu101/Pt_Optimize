+
+    [Fact]
+    public void 周期检测_二周期与三周期报判不了_周期成员全部列出()
+    {
+        // 二周期：片0 上一轮圆盘层为 0 ⇒ 选 8，否则选 0
+        PointOutcome Two(Selection sel, int j, int dd, int ww)
