+for lbl, tt in (("J=10 求解器解 舌片厚 2.03", 2.03), ("J=11 理论下限 舌片厚 1.84", 1.84)):
+    z = zero_ins(tt, I0)
+    a,gc,lc = cap_zone(z, T_ROOT, tt, I0)
