+            }
+            else
+            {
+                int a = c, b = c;
+                while (a - 1 >= 0 && ok[a - 1] == true) a--;
+                while (b + 1 < pts.Count && ok[b + 1] == true) b++;
+                lo = pts[a]; hi = pts[b]; width = hi - lo;
