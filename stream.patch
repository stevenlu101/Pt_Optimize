+for L in (80, 110, 125, 140):
+    Th = TC0 - PROBE[L]['cold']
+    a,gc,lc = cap_zone(T_INS, Th, T_TAB, I_ENTRY)
+    r = solve_tab(-R_HOLE, -(L-CLAMP_L), T_TAB, I_ENTRY, T_INS, T_hot=Th, N=1500)
