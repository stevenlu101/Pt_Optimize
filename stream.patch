+            double a = PtThermalExpansion.DefinedPointInterpBelowC;
+            return $"⚠ {Id} 的瞬时 α 在 {a:0} °C 有台阶：{a:0} °C 以下 = {a:0} °C 平均 α {l:0.0000}，"
+                 + $"{a:0} °C 起 = 多项式导数 {r:0.0000}（台阶 {p:+0.0;−0.0} %）";
