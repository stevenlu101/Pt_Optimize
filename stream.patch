+        var hit = Directory.GetFiles(dir, "R48_空管稳态_*.json")
+                           .Select(f => (f, m: pat.Match(Path.GetFileName(f))))
+                           .Where(x => x.m.Success)
+                           .OrderByDescending(x => x.m.Groups[1].Value, StringComparer.Ordinal)
+                           .FirstOrDefault();
