+        /// 冷态 Q_散热≈0 且 C·rate 极小 ⇒ 电流只有几十安，与顶满电流是两个世界。
+        /// </summary>
+        public double CurrentAt(double tt, double tf, double qLossTubeW, double qCoupleW)
