+                }
+                sb.AppendLine($"        本点判定用的放大倍数（生产，两段四端取最大）= {ampProd:0.000}　⇒ 停机估计 步长 {lastDelta:0.0000} × {ampProd:0.0} = {lastDelta * ampProd:0.000} K，"
