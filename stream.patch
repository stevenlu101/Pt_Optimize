+    [Fact] public void 空管续跑_管腔辐射高档() => Run(SegmentSolver.CavityRadKA1150High);
+    /// <summary>冒烟：同一段代码走开箱网格、续跑至多 5 轮，输出写系统临时目录（不进 deliverable、不读结论）—— 长跑之前先确认整条打印／判读／机读行不崩。</summary>
