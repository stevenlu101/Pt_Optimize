+    {
+        // 列内取常数（中点律）⇒ 被积函数对 x 线性时**逐列精确**。闭式 ∫(a+b·x)dx。
+        const double xLo = -100, xHi = 0; const double a = 1e-3, b = 5e-6;
+        foreach (int n in new[] { 8, 97, 1000 })
+        {
