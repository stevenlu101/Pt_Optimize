+                    sb.AppendLine($"        参考（不进判读）段「{s0.Name}」：① 生产现行（管根温度取值）T根 {s0.TRootAC:0.00}/{s0.TRootBC:0.00} °C　"
+                                + $"β′ {s0.EndBetaAWPerMK:0.0000}/{s0.EndBetaBWPerMK:0.0000} W/(m·K)　ℓt {s0.EndDecayLengthAMm:0.0}/{s0.EndDecayLengthBMm:0.0} mm　"
