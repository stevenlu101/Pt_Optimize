+        foreach (var (name, v) in new[] { ("玻璃出口", r.TGlassOutC), ("含玻璃时间常数", r.TauWithGlassS), ("流速", r.VelocityMmPerS),
+                                          ("停留时间", r.ResidenceS), ("压降", r.PressureDropKPa), ("流动水头", r.GlassHeadM),
