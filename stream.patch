+    /// <summary>摄氏 → 开尔文的偏移（对数平均必须在绝对温标上取）。</summary>
+    public const double KelvinOffset = 273.15;
+
+    /// <summary>
+    /// ★★★★★ R48 B（2026-09-14 Opus 5）：第 <paramref name="flangeIndex"/> 片法兰的**热偶读数基准** °C —— 热侧、冷侧两条判据的唯一基准。
+    ///
