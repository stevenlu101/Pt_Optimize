+        Assert.False(DesignScreen.FlangeFaceInsulated(lc.DiscInsulEffectiveAt(0)));
+        Assert.True(DesignScreen.FlangeFaceInsulated(lc.DiscInsulEffectiveAt(1)));
+    }
+}
