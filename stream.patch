+        double cf = A * L / Math.PI;
+        _o.WriteLine($"ΔL_A {dA:0.000000000} / 闭式 +{cf:0.000000000}　ΔL_B {dB:0.000000000} / 闭式 −{cf:0.000000000}　整段 {dA + dB:E3}");
