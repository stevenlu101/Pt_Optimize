#!/bin/sh
# ★★★★★ 提交格式门（2026-09-05 用户拍板）
#
# 最高准则：**我可以做错，不可以让你以为的和事实不一样。**
#
# 当天四次「搞混」里，有一次是提交里写「验过了」而全套界面测试没跑。
# 这个钩子挡不住犯错，但**逼把话说死** —— 三段缺一段就不许提交：
#
#   跑了什么：<命令 + 关键输出行>      ← 没跑就填不出来，自己会发现
#   不覆盖：  <这次没验到的>            ← 逼着承认边界
#   成本：    <动求解器时：多几次全解>  ← 逼着先算成本再动手
#
# 确实要跳过：git commit --no-verify

MSG=$(cat "$1" | grep -v '^#')

miss=""
echo "$MSG" | grep -q "跑了什么" || miss="$miss 跑了什么"
echo "$MSG" | grep -q "不覆盖"   || miss="$miss 不覆盖"
echo "$MSG" | grep -q "成本"     || miss="$miss 成本"

if [ -n "$miss" ]; then
    echo ""
    echo "✗ 提交消息缺这几段：$miss"
    echo ""
    echo "  每个提交都要有三段（缺一不可）："
    echo "    跑了什么：dotnet test 620/620；--reconcile 0.8 → 3481 g 一致"
    echo "    不覆盖：  没跑全套界面测试；4 段没验"
    echo "    成本：    多算 5 次全解"
    echo ""
    echo "  为什么：2026-09-05 有一次提交写「验过了」而全套界面测试没跑 ——"
    echo "  用户以为验证覆盖到了。**做错可以，让人以为的和事实不一样不行。**"
    echo ""
    echo "  确实要跳过：git commit --no-verify"
    exit 1
fi
exit 0
