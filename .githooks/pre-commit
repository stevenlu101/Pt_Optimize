#!/bin/sh
# ============================================================================
#  提交前自检门（2026-08-16）
#
#  为什么要有它：本项目被抓到的错，靠的全是**会自己跑的检查**；
#  写在注释里的教训一次也没抓到过 —— 注释不会跑，要人记得去跑的工具也等于不会跑。
#
#  ⚠ 只在**动了会影响判定的东西**时才拦，否则改个文档也要等几分钟，门就会被人关掉。
#     门要有人愿意一直开着才有用。
#
#  跳过：git commit --no-verify   （赶时间可以，但请自己知道跳过了什么）
#  安装：git config core.hooksPath .githooks
# ============================================================================
set -e

# ⚠ 名单里除了「被验的东西」，还必须有「**验的那一套**」本身 ——
#   改测试改的是「门断言什么」，改本文件改的是「门跑不跑」。
#   这两类若不在名单里，**唯一能让所有门失效的改动，恰恰是唯一不触发门的改动**。
#   （2026-08-24 实测：补 dotnet test 进钩子那一次提交，因为只动了
#     .githooks/ 与 HANDOVER.md，门整个没跑，而我在提交讯息里写了「四道全绿」。）
WATCH='Pt_Optimize/Core/|Pt_Optimize/Program.cs|Pt_Optimize/UI/'
WATCH="$WATCH|Pt_Optimize\.Tests/|tests/UiWiring/|Pt_Optimize\.Geom/|\.githooks/"
CHANGED=$(git diff --cached --name-only | grep -E "$WATCH" || true)

if [ -z "$CHANGED" ]; then
    exit 0
fi

echo "── 动到会影响判定的档，跑自检门（约 7 分钟；--no-verify 可跳过）"
echo "$CHANGED" | sed 's/^/     /'

ROOT=$(git rev-parse --show-toplevel)
BIN="$ROOT/Pt_Optimize/bin/Release/net8.0-windows"

# ⚠ 必须先编译。否则门验的是**上一次的二进制** —— 那比不验更危险：
#   它会给这次的改动发一张不属于它的通过证。
# ============================================================================
#  ★★★★★ 编译前先清掉**锁住输出档的残留进程**（2026-09-08）
#
#  真事，一晚上两次：
#    · 提交时 testhost(11156) 锁住 Pt_Optimize.dll ⇒ MSB3027 ⇒ **编译失败、提交中止**
#    · 督导那边 Pt_Optimize.Geom.exe(8916) 锁住自己 ⇒ **那一次 Geom 没编成**
#
#  ⚠ 第二种比第一种危险得多：它**不会让提交中止**，只是那一个子项目没编上 ⇒
#    后面的门（探针、出图往返）拿的是**上一次的二进制**。
#    与本档第 35 行「否则门验的是上一次的二进制」是同一族，只是从主程序挪到了子程序。
#
#  ⇒ 不靠记性，靠这一步。只杀本仓自己的产物进程，不碰别的。
# ============================================================================
echo "── 清残留进程（testhost / Pt_Optimize.Geom / Pt_Optimize）"
for proc in testhost Pt_Optimize.Geom Pt_Optimize; do
  # tasklist 找得到才杀，避免每次都打一堆红字
  if tasklist //FI "IMAGENAME eq $proc.exe" 2>/dev/null | grep -qi "$proc.exe"; then
    echo "     残留 $proc.exe ⇒ 结束它（否则它锁住的那个子项目会**静默地不重编**）"
    taskkill //F //IM "$proc.exe" //T > /dev/null 2>&1 || true
  fi
done

echo "── 先编译（Release）"
if ! dotnet build "$ROOT/Pt_Optimize.sln" -c Release -v q --nologo > /tmp/pt_build.log 2>&1; then
    echo "✗ 编译失败，提交中止："
    grep -E ": error" /tmp/pt_build.log | head -20
    exit 1
fi
if ! dotnet build "$ROOT/tests/UiWiring/UiWiring.csproj" -c Release -v q --nologo >> /tmp/pt_build.log 2>&1; then
    echo "✗ 界面接线测试编译失败，提交中止："
    grep -E ": error" /tmp/pt_build.log | head -20
    exit 1
fi

# 四道合计约 9 分钟（2026-09-07 实测重定）：编译 ~30 s + 单元测试**快门 1 m 25 s / 670 条**
#   + 界面接线 ~150 s + 自检门 ~225 s。
#   自检门本来是 8 分钟，把 A/B/C 九次彼此独立的整线解并行预算之后降到 3.7 分钟，
#   **输出逐字节一致**（判据先立后改）。见 HANDOVER §8。
#
# ① 单元测试（**快门 1 m 25 s / 670 条**，2026-09-07 实测）。守的是**纯判断逻辑** ——
#    ⚠ 原写「约 15 秒」是 2026-08-24 的数，早已过期：全套 679 条里有 9 条真跑场解/出图，
#      实测跑 24 分钟没跑完。现按 Trait「速度=慢」分层，这里只跑快门。
#    裕度符号、接头取厚、趋势判定、外推分档这一类。
#    ⚠ 这一段是 2026-08-24 才补的：在那之前每条提交讯息都写着「dotnet test NN/NN」，
#      而钩子**从来没跑过它** —— 一句没有机制撑着的断言，正是本项目最忌的那种。
#      测试项目就在 sln 里，上面那次 build 已经编过，所以 --no-build，几乎不加时间。
#    ⚠ --no-build **靠上面那道编译闸撑着**：编译失败时 dotnet test 会拿**上一次的 DLL**
#      照样报「全过」（补这段时实测到了）。所以那道闸的 exit 1 不能省，
#      也不要把本段挪到编译之前。
echo "── 单元测试（快门；慢门 Trait 速度=慢 默认跳过）"
# ★★★★★ **门要分层，否则下一次就是 --no-verify**（2026-09-07 督导 S3）。
#
#   实测：这一钩子自述「15 秒」，真跑全套 **24 分钟没跑完就被中止**。
#   原因是几条门自己真跑场解/出图，它们的注释自己写着代价：
#     ComboAccumulate 单根补不上时…      1 h 21 m
#     ExportOptimized3dm 出一版优化后的3dm  97 分钟（而且它自称「不是回归门，是交付物」）
#     ReconcileTrace 打出0点8档的求解轨迹   76 → 41.7 分钟
#   一小时的门没人愿意一直开着 —— 而这钩子自己写过「门要有人愿意一直开着才有用」。
#
#   ⇒ 慢门打 Trait「速度=慢」，提交时跳过；发版前用下面这条单独跑：
#       dotnet test Pt_Optimize.sln -c Release --filter "速度=慢"
#   ⚠ 跳过 ≠ 取消：慢门仍在版控里、仍是验收标准，只是不挡每一次提交。
# ⚠ 不要写成 `if ! dotnet test | grep ...` —— 管道的退出码是**最后一段**的。
#   测试失败时输出里恰好有「失败!」，grep 匹配到就退出 0 ⇒ 取反为假 ⇒ 失败被吞掉。
#   （这个坑我在补这段时当场踩了一次。）先跑、只看它自己的退出码，再挑行显示。
# -v n 而不是 -v q：q 只打得出测试名，打不出断言内容；明细只在失败时才捞。
dotnet test "$ROOT/Pt_Optimize.sln" -c Release --no-build --nologo -v n     --filter "速度!=慢" > /tmp/pt_test.log 2>&1
rc=$?
grep -E "测试运行(成功|失败)|^ +(通过数|失败数|总数|已跳过)" /tmp/pt_test.log | sed 's/^ */   /'
if [ $rc -ne 0 ]; then
    echo "✗ 单元测试不过 —— 提交中止，红的是这几条："
    grep -E "\[FAIL\]" /tmp/pt_test.log | sed 's/^/   /' | head -20
    grep -A6 -E "\[FAIL\]" /tmp/pt_test.log | grep -E "Assert|Expected|Actual|预期|实际" | head -20
    echo "  完整明细：/tmp/pt_test.log"
    exit 1
fi

# ② 界面接线（秒级）。GUI「编译过」不代表「接对了」——
#    实测抓到过「求解中改参数，作废的那次还要跑满 1.5 秒防抖窗口才被取消」，
#    这种错只在运行时现形，编译器和 --selfcheck 都看不见。
echo "── 界面接线测试"
if ! "$ROOT/tests/UiWiring/bin/Release/net8.0-windows/UiWiring.exe"; then
    echo ""
    echo "✗ 界面接线测试不过 —— 提交中止。上面标 ✗ 的那一项指到了具体哪一环。"
    exit 1
fi

# ③ 内核自检（分钟级）：复现对账 + 不安静失败
cd "$BIN"
if ! dotnet Pt_Optimize.dll --cli --quiet --selfcheck; then
    echo ""
    echo "✗ 自检不过 —— 提交中止。"
    echo "  上面标 ✗ 的是「定案档自己不过判据」或「记录值与实算对不上」，"
    echo "  两者都属于会安静发出错结论的那一类，先查清楚再提交。"
    echo "  确实要跳过：git commit --no-verify"
    exit 1
fi

exit 0
